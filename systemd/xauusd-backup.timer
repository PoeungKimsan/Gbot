[Unit]
Description=Nightly XAUUSD journal backup
Documentation=https://github.com/xauusd/xauusd-lab

[Timer]
# 01:17 local, deliberately not a round hour: a host whose other crons all fire on the hour
# is a host where 01:00 is the busiest minute it has, and the backup's whole job is to read
# the journal while nobody else is writing.
OnCalendar=*-*-* 01:17:00
# A missed run — the host was down — fires on the next boot instead of silently skipping a
# night of history.
Persistent=true
AccuracySec=1min

Unit=xauusd-backup.service

[Install]
WantedBy=timers.target
