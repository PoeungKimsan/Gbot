# Normalize every text file to LF in the repository, on every host.
* text=auto eol=lf

# --- explicitly text: always LF in the index and in the worktree ------------
*.py text eol=lf
*.pyi text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.env text eol=lf
*.example text eol=lf

# Frontend
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf

# --- explicitly binary: never diffed, never line-ending mangled -------------
*.db binary
*.db-wal binary
*.db-shm binary
*.sqlite binary
*.sqlite-wal binary
*.sqlite-shm binary
*.parquet binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.zip binary
*.gz binary
