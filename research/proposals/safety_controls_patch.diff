diff --git a/config/risk.yaml b/config/risk.yaml
--- a/config/risk.yaml
+++ b/config/risk.yaml
@@ -10,3 +10,12 @@ risk_per_trade: "0.01"
 # Daily loss limit, in R. Reaching -3R for the trading day trips the kill-switch,
 # which latches until the day rolls over at 17:00 America/New_York.
 daily_loss_limit_r: "3"
+
+# Minimum stop-loss distance in price units: max(broker_minimum, 3x spread).
+# Rejects and logs any signal whose stop distance is below this realism floor.
+min_stop_distance: "0.60"
+
+# Maximum allowable leverage ratio (notional / equity).
+max_leverage_ratio: "30.0"
+
+# Maximum lot size clamp per order.
+max_lot_size: "10.00"
