# Production environment template for the xauusd-lab control plane.
#
# Copy to config/prod.env and fill in the values. That file is git-ignored
# (see .gitignore); only this example is tracked.
#
# Every key below is read by engine.runtime.platform. Later phases append their
# own keys to this template as they are provisioned - nothing is added ahead of
# its phase.

# --- control plane ----------------------------------------------------------
# TCP port the supervisor binds on loopback (127.0.0.1). Defaults to 8765.
XAUUSD_CONTROL_PORT=8765

# Shared token required to issue control commands (start, stop, flatten).
# There is no insecure default: without a token the control plane refuses to
# start rather than accepting unauthenticated commands.
#
# Two equivalent sources - pick one:
#   1. define the value here below, or
#   2. write the bare token into config/control.token (git-ignored).
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
XAUUSD_CONTROL_TOKEN=
